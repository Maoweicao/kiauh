From b7f7850f6f74ea646fdb2655c17decb201a5ab37 Mon Sep 17 00:00:00 2001
From: Maoweicao <Maoweicao@users.noreply.github.com>
Date: Mon, 4 May 2026 18:26:12 +0800
Subject: [PATCH 4/7] feat(i18n): convert core UI infrastructure to use
 translations

- Logger: make [INFO]/[OK]/[WARN]/[ERROR] prefix labels translatable
- BaseMenu: translate header title/subtitle, footer (Quit/Back/Help) texts
- BaseMenu: translate 'Happy printing!' and unexpected error messages
- Input utils: translate validation error messages
- ComponentStatus: use translation keys in StatusMap (resolved lazily via _())
---
 kiauh/core/logger.py                 | 11 ++++++-----
 kiauh/core/menus/base_menu.py        | 17 +++++++++--------
 kiauh/core/types/component_status.py |  8 ++++----
 kiauh/utils/input_utils.py           | 14 +++++++-------
 4 files changed, 26 insertions(+), 24 deletions(-)

diff --git a/kiauh/core/logger.py b/kiauh/core/logger.py
index 27dc1e7..5718ee5 100644
--- a/kiauh/core/logger.py
+++ b/kiauh/core/logger.py
@@ -12,6 +12,7 @@ import textwrap
 from enum import Enum
 from typing import List
 
+from core.i18n import _
 from core.types.color import Color
 
 
@@ -37,27 +38,27 @@ BORDER_RIGHT: str = "┃"
 class Logger:
     @staticmethod
     def print_info(msg, prefix=True, start="", end="\n") -> None:
-        message = f"[INFO] {msg}" if prefix else msg
+        message = _("logger.info", msg=msg) if prefix else msg
         Logger.__print(Color.WHITE, start, message, end)
 
     @staticmethod
     def print_ok(msg: str = "Success!", prefix=True, start="", end="\n") -> None:
-        message = f"[OK] {msg}" if prefix else msg
+        message = _("logger.ok", msg=msg) if prefix else msg
         Logger.__print(Color.GREEN, start, message, end)
 
     @staticmethod
     def print_warn(msg, prefix=True, start="", end="\n") -> None:
-        message = f"[WARN] {msg}" if prefix else msg
+        message = _("logger.warn", msg=msg) if prefix else msg
         Logger.__print(Color.YELLOW, start, message, end)
 
     @staticmethod
     def print_error(msg, prefix=True, start="", end="\n") -> None:
-        message = f"[ERROR] {msg}" if prefix else msg
+        message = _("logger.error", msg=msg) if prefix else msg
         Logger.__print(Color.RED, start, message, end)
 
     @staticmethod
     def print_status(msg, prefix=True, start="", end="\n") -> None:
-        message = f"\n###### {msg}" if prefix else msg
+        message = _("logger.status", msg=msg) if prefix else msg
         Logger.__print(Color.MAGENTA, start, message, end)
 
     @staticmethod
